# Variable names for shell or deployment configuration.
# The application reads process.env; it does not automatically load this file.
PORT=3000
WORKAI_HOST=127.0.0.1
WORKAI_REMOTE_ROOT=/workspace/workai-remote
WORKAI_STATE_DIR=/workspace/workai-remote/web/jobs

# Required only for externally accessible HTTPS deployments.
# Set the real password through secure runtime configuration, never in Git.
# WORKAI_WEB_ORIGIN=https://workai.example.com
# WORKAI_WEB_PASSWORD=
